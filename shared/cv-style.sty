% cv-style.sty: shared layout for all of David Adegbola's role-specific CVs.
% Layout from hmemcpy/cv template (adapted from Professional CV by Alessandro Plasmati).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-style}

\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[usenames,dvipsnames]{xcolor}
\usepackage{libertine}
\usepackage{fontawesome}
\usepackage{longtable}
\usepackage{colortbl}
\arrayrulecolor{black!35}
\usepackage[cm]{fullpage}
\usepackage{amssymb}

% Per-CV role shown in the footer: set with \cvrole{...} in each cv.tex
\newcommand{\cv@role}{}
\newcommand{\cvrole}[1]{\renewcommand{\cv@role}{#1}}

% Language of the fixed labels: \cvlang{en} (default) or \cvlang{fi}, in the preamble.
% Look labels up with \cvt{key}, e.g. \section{\cvt{experience}} or \textsc{\cvt{phone}:}.
\newcommand{\cv@lang}{en}
\newcommand{\cv@def}[3]{\expandafter\def\csname cv@#1@#2\endcsname{#3}}
\newcommand{\cvt}[1]{\csname cv@\cv@lang @#1\endcsname}
\newcommand{\cvlang}[1]{%
  \renewcommand{\cv@lang}{#1}%
  \def\cv@tmp{#1}\def\cv@fi{fi}%
  \ifx\cv@tmp\cv@fi \RequirePackage[finnish]{babel}\fi}
\@onlypreamble\cvlang

\cv@def{en}{location}{Location}         \cv@def{fi}{location}{Sijainti}
\cv@def{en}{phone}{Phone}               \cv@def{fi}{phone}{Puhelin}
\cv@def{en}{email}{Email}               \cv@def{fi}{email}{Sähköposti}
\cv@def{en}{links}{Links}               \cv@def{fi}{links}{Linkit}
\cv@def{en}{summary}{Summary}           \cv@def{fi}{summary}{Yhteenveto}
\cv@def{en}{skills}{Skills}             \cv@def{fi}{skills}{Taidot}
\cv@def{en}{experience}{Work Experience} \cv@def{fi}{experience}{Työkokemus}
\cv@def{en}{volunteering}{Volunteering and Projects} \cv@def{fi}{volunteering}{Vapaaehtoistyö ja projektit}
\cv@def{en}{education}{Education}       \cv@def{fi}{education}{Koulutus}
\cv@def{en}{cards}{Cards}               \cv@def{fi}{cards}{Kortit}
\cv@def{en}{certificates}{Certificates} \cv@def{fi}{certificates}{Todistukset}
\cv@def{en}{languages}{Languages}       \cv@def{fi}{languages}{Kielet}
\cv@def{en}{references}{References}     \cv@def{fi}{references}{Suosittelijat}
\cv@def{en}{refsavailable}{Available on request.} \cv@def{fi}{refsavailable}{Suosittelijat pyydettäessä.}
\cv@def{en}{pageof}{Page \thepage\ of \pageref*{LastPage}}
\cv@def{fi}{pageof}{Sivu \thepage\,/\,\pageref*{LastPage}}
% joins job title and employer in \job: "Title at Employer" / "Title, Employer"
\cv@def{en}{at}{ at }                   \cv@def{fi}{at}{, }

% headers and footers
\usepackage{fancyhdr}
\usepackage{lastpage}
\pagestyle{fancy}
\fancyfoot[L]{David Adegbola}
\fancyfoot[C]{\cvt{pageof}}
\fancyfoot[R]{\cv@role}
\renewcommand{\footrulewidth}{0.4pt}
\fancyhead{}
\renewcommand{\headrulewidth}{0pt}

% StackOverflow-like tags
\usepackage{tikz}
\definecolor{tagbg}{RGB}{225,236,244}
\definecolor{tagtxt}{RGB}{88,115,159}
\newcommand{\sotag}[1]{\tikz[baseline]{\node[anchor=base, rounded corners=0.5ex, text height=1.5ex, text depth=.25ex, fill=tagbg, draw=tagbg, text=tagtxt] {#1};}}
\newcommand{\sotagrow}[1]{\par\vspace{4pt}\noindent\@for\sotagitem:=#1\do{\sotag{\sotagitem} }\\}

% Helpers for adding job entries
\newcommand{\job}[2]{\large\sffamily \textbf{#1}\cvt{at}\textbf{#2}\rule[-0.45em]{0pt}{1.45em}}
\newcommand{\sep}{\multicolumn{2}{c}{}\\}

% Optional profile photo (off by default). Call \cvphoto{<path>} in a CV's preamble to show it
% as a 3 cm circle left of the header; wrap the header (name, role, contact table) in
% \begin{cvheader}...\end{cvheader}. Without \cvphoto the environment changes nothing.
% A missing photo file only gives a warning, and the CV compiles without it.
\usepackage{graphicx}
\newif\ifcv@photo
\newcommand{\cv@photopath}{}
\newcommand{\cvphoto}[1]{%
  \IfFileExists{#1}%
    {\cv@phototrue\renewcommand{\cv@photopath}{#1}}%
    {\PackageWarning{cv-style}{Photo file `#1' not found, compiling without a photo}}}
\@onlypreamble\cvphoto
\newlength{\cv@photosize}\setlength{\cv@photosize}{3cm}
\newsavebox{\cv@photoraw}
% Scale the photo to cover the circle (whichever side is shorter fills 3 cm), then clip
\newcommand{\cv@photocircle}{%
  \sbox{\cv@photoraw}{\includegraphics{\cv@photopath}}%
  \ifdim\wd\cv@photoraw<\ht\cv@photoraw
    \sbox{\cv@photoraw}{\includegraphics[width=\cv@photosize]{\cv@photopath}}%
  \else
    \sbox{\cv@photoraw}{\includegraphics[height=\cv@photosize]{\cv@photopath}}%
  \fi
  \begin{tikzpicture}
    \begin{scope}
      \clip (0,0) circle (0.5\cv@photosize);
      \node[inner sep=0pt] at (0,0) {\usebox{\cv@photoraw}};
    \end{scope}
    \draw[tagtxt, line width=0.8pt] (0,0) circle (0.5\cv@photosize);
  \end{tikzpicture}}
\newenvironment{cvheader}
  {\ifcv@photo
     \par\noindent
     \begin{minipage}[c]{\dimexpr\cv@photosize+2pt\relax}\cv@photocircle\end{minipage}%
     \hspace{1.2em}%
     \begin{minipage}[c]{\dimexpr\textwidth-\cv@photosize-2pt-1.2em\relax}%
   \fi}
  {\ifcv@photo
     \end{minipage}\par
   \fi}

\usepackage{hyperref}
\definecolor{linkcolor}{rgb}{0,0.2,0.6}
\hypersetup{colorlinks,breaklinks,urlcolor=linkcolor, linkcolor=linkcolor}

\usepackage{titlesec}
\titleformat{\section}{\Large\scshape\raggedright}{}{0em}{}[\titlerule]
\titlespacing{\section}{0pt}{1em}{3pt}

