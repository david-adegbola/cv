#!/bin/sh
set -eu

message_file=${1:?commit message file is required}
repo_root=$(git rev-parse --show-toplevel)
hooks_dir=$(git rev-parse --git-path hooks)
case $hooks_dir in
  /*) ;;
  *) hooks_dir=$repo_root/$hooks_dir ;;
esac
existing_hook=$hooks_dir/commit-msg.pre-ai-trailer

filter_agent_trailers() {
  temporary_file=$(mktemp "${message_file}.XXXXXX")
  trap 'rm -f "$temporary_file"' EXIT HUP INT TERM

  awk '
  {
    line = tolower($0)
    is_trailer = line ~ /^co-authored-by:[[:space:]]*/
    is_agent = line ~ /copilot/ || line ~ /claude code/ ||
      line ~ /claude[[:space:]]*<[^>]*@anthropic\.com>/ ||
      line ~ /anthropic/ || line ~ /openai/ || line ~ /chatgpt/ ||
      line ~ /(^|[^[:alnum:]])codex([^[:alnum:]]|$)/ ||
      line ~ /cursor[[:space:]]*(ai|assistant)/ ||
      line ~ /gemini[[:space:]]*(ai|assistant)/ ||
      line ~ /amazon q/ || line ~ /devin[[:space:]]*(ai|assistant)/ ||
      line ~ /\[bot\]/
    if (is_trailer && is_agent) {
      removed++
      next
    }
    print
  }
  END {
    if (removed > 0)
      printf "Removed %d AI-agent Co-authored-by trailer(s); human co-authors were preserved.\n", removed > "/dev/stderr"
  }
  ' "$message_file" >"$temporary_file"

  if ! cmp -s "$message_file" "$temporary_file"; then
    cat "$temporary_file" >"$message_file"
  fi

  rm -f "$temporary_file"
  trap - EXIT HUP INT TERM
}

filter_agent_trailers

if [ -x "$existing_hook" ]; then
  "$existing_hook" "$message_file"
fi

filter_agent_trailers
